# Default config for imv

[options]

# Suppress built-in key bindings, and specify them explicitly in this
# config file.
suppress_default_binds = true
fullscreen = true
overlay_font = Monospace:16
# upscaling_method = nearest_neighbour
# background = checks

[aliases]
# Define aliases here. Any arguments passed to an alias are appended to the
# command.
# alias = command to run

[binds]

# Edit
e = exec swappy -f "$imv_current_file" &

# Image navigation
<Left> = prev
<bracketleft> = prev
<Prior> = prev
<XF86Back> = prev
<Right> = next
<bracketright> = next
<Next> = next
<XF86Forward> = prev
gg = goto 1
<Shift+G> = goto -1

# Panning
j = pan 0 -50
k = pan 0 50
h = pan 50 0
l = pan -50 0
#c = center

# Zooming
<Up> = zoom 1
<equal> = zoom 1
i = zoom 1
<Down> = zoom -1
<minus> = zoom -1
o = zoom -1
s = scaling next
#a = zoom actual
#r = reset

# Rotate Clockwise by 90 degrees
<r> = rotate by 90
<Ctrl+r> = exec mogrify -rotate 90 "$imv_current_file"; reset

# Close and delete
x = close
<Ctrl+x> = exec trash-put "$imv_current_file"; close

# Interaction with other programs
# <Ctrl+c> = exec echo -n "$imv_current_file" | xclip -selection clipboard ;;
<Ctrl+g> = exec gimp "$imv_current_file" &

# Other commands
q = quit
f = fullscreen
d = overlay
p = exec echo $imv_current_file
#<Shift+S> = upscaling next

# Gif playback
<period> = next_frame
<space> = toggle_playing

# Slideshow control
t = slideshow +1
<Shift+T> = slideshow -1

# Background
b = background 000000
<Ctrl+b> = background checks
